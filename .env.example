# Скопируйте в .env и при необходимости задайте значения. Без .env проект тоже запускается:
# секрет для кодов входа сервер сгенерирует сам, письма уходят в Mailpit (http://localhost:8025).

# Пароль базы (по умолчанию ezmarket - только для локального запуска)
POSTGRES_PASSWORD=

# Секрет HMAC для кодов входа, не короче 32 символов. Пусто - сгенерируется при первом старте
AUTH_CODE_SECRET=

# true - если сайт открывается по HTTPS (стенд)
COOKIE_SECURE=false

# Настоящая почта вместо Mailpit (по умолчанию mailpit:1025)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Порты сайта и Mailpit (на сервере сайт обычно на 80)
WEB_PORT=
MAILPIT_PORT=
# Вход в интерфейс Mailpit "логин:пароль" - обязательно, если сервер открыт в интернет
MAILPIT_UI_AUTH=

# Демо-стенд без почты: код подставляется в поле сам (true). В проде - false
AUTH_DEMO_CODE=
# Повторный код через N секунд (60) и не больше M кодов в час (5)
AUTH_RESEND_SECONDS=
AUTH_CODES_PER_HOUR=

# Секрет подписи уведомлений об оплате (X-Signature), не короче 32 символов. Пусто - сгенерируется при первом старте
PAYMENT_WEBHOOK_SECRET=
# Платежка: fake - встроенная тестовая (страница оплаты без списания денег), cryptopay - Crypto Pay (@CryptoBot)
PAYMENT_PROVIDER=
# Токен приложения Crypto Pay (бот -> Crypto Pay -> My Apps). Только здесь, в репозиторий не класть
CRYPTOPAY_TOKEN=
# testnet (@CryptoTestnetBot, тестовые монеты) или mainnet
CRYPTOPAY_NETWORK=
# Адрес сайта для кнопки «Вернуться в магазин» после оплаты в боте
SITE_URL=
