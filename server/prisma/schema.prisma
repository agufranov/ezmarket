// Схема базы EzMarket. Гарантии держит сама база: уникальные ключи, CHECK, транзакции.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String             @id @default(uuid())
  // email храним в нижнем регистре - уникальность без учета регистра
  email             String             @unique
  name              String?
  // промокод или код друга, с которым пришел при регистрации
  promo             String?
  // 1 бонус = 1 ₽; не ниже нуля - CHECK в миграции
  bonusBalance      Int                @default(0) @map("bonus_balance")
  createdAt         DateTime           @default(now()) @map("created_at")
  sessions          Session[]
  orders            Order[]
  bonusTransactions BonusTransaction[]
  notifications     Notification[]

  @@map("users")
}

// Статусы заказа пополнения Steam. Допустимые переходы проверяет триггер в миграции 20261026090000_orders
enum OrderStatus {
  created
  pending
  paid
  processing
  completed
  failed
  canceled
  expired

  @@map("order_status")
}

// Заказ пополнения Steam. Текущий статус - здесь, каждая его смена пишется триггером в order_status_history
model Order {
  id                String               @id @default(uuid())
  userId            String               @map("user_id")
  user              User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  // ключ повтора от клиента: повторный POST с тем же ключом вернет тот же заказ
  idempotencyKey    String               @map("idempotency_key")
  steamLogin        String               @map("steam_login")
  // суммы - целым числом в минимальных единицах валюты (копейки, центы, тиыны)
  amount            Int
  currency          String
  // сколько платить деньгами: amount минус бонусы (bonus_spent × 100) - CHECK в миграции бонусов
  payAmount         Int                  @map("pay_amount")
  status            OrderStatus          @default(created)
  // неоплаченный заказ истекает через 30 минут после создания
  expiresAt         DateTime             @map("expires_at")
  // выполнение: когда заказ последний раз взят в работу и сколько было попыток. Захват с ограниченным сроком:
  // если процесс упал или не записал итог, заказ в processing берется снова (OrdersWorker)
  fulfilClaimedAt   DateTime?            @map("fulfil_claimed_at")
  fulfilAttempts    Int                  @default(0) @map("fulfil_attempts")
  // платеж: какая платежная система (fake | cryptopay) и его id у нее
  paymentProvider   String?              @map("payment_provider")
  paymentId         String?              @unique @map("payment_id")
  // куда отправить покупателя платить (страница тестовой платежки или счет в боте Crypto Pay)
  paymentUrl        String?              @map("payment_url")
  // бонусы: списано в оплату (1 бонус = 1 ₽, не больше 30% суммы, только RUB) и начислится за выполненный заказ (кэшбэк)
  bonusSpent        Int                  @default(0) @map("bonus_spent")
  bonusAccrual      Int                  @default(0) @map("bonus_accrual")
  bonusTransactions BonusTransaction[]
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  history           OrderStatusHistory[]
  paymentEvents     PaymentEvent[]
  notifications     Notification[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([paymentProvider, status])
  @@map("orders")
}

// История статусов: строки добавляет только триггер, приложение их не пишет
model OrderStatusHistory {
  id           BigInt        @id @default(autoincrement())
  orderId      String        @map("order_id")
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus   OrderStatus?  @map("from_status")
  toStatus     OrderStatus   @map("to_status")
  reason       String?
  createdAt    DateTime      @default(now()) @map("created_at")
  notification Notification?

  @@index([orderId, id])
  @@map("order_status_history")
}

// Коды входа: сам код нигде не хранится, только HMAC-SHA256 с серверным секретом
model AuthCode {
  id        String    @id @default(uuid())
  email     String
  codeHash  String    @map("code_hash")
  mode      String
  promo     String?
  attempts  Int       @default(0)
  expiresAt DateTime  @map("expires_at")
  // погашен: вход выполнен, исчерпаны попытки или выдан новый код
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@map("auth_codes")
}

// Сессии: в cookie случайный токен, в базе только его SHA-256
model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("sessions")
}

model PromoCode {
  code   String  @id
  active Boolean @default(true)

  @@map("promo_codes")
}

// Исходящие письма: создаются в одной транзакции с действием, отправляет воркер с повторами
model EmailOutbox {
  id        String    @id @default(uuid())
  to        String
  subject   String
  text      String
  html      String?
  attempts  Int       @default(0)
  nextTryAt DateTime  @default(now()) @map("next_try_at")
  sentAt    DateTime? @map("sent_at")
  error     String?
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([sentAt, nextTryAt])
  @@map("email_outbox")
}

// Уведомления платежной системы. id события уникален: повтор того же уведомления не обрабатывается второй раз.
// result - что сделали: applied | already_paid | late | amount_mismatch | unknown_payment
model PaymentEvent {
  id              String   @id @default(uuid())
  providerEventId String   @unique @map("provider_event_id")
  paymentId       String   @map("payment_id")
  orderId         String?  @map("order_id")
  order           Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  type            String
  amount          Int
  currency        String
  result          String
  payload         Json
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([paymentId])
  @@index([orderId])
  @@map("payment_events")
}

// Виды движения бонусов
enum BonusKind {
  signup // за регистрацию
  spend // списание в оплату заказа
  refund // возврат списанного: заказ отменен, истек или завершился ошибкой
  accrual // кэшбэк за выполненный заказ

  @@map("bonus_kind")
}

// История бонусов: каждое начисление и списание - строка; users.bonus_balance всегда равен сумме delta.
// Возврат и кэшбэк по заказу пишет триггер на смену статуса (миграция 20261027090000_bonuses), один раз на заказ
model BonusTransaction {
  id           BigInt        @id @default(autoincrement())
  userId       String        @map("user_id")
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId      String?       @map("order_id")
  order        Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  kind         BonusKind
  delta        Int
  balanceAfter Int           @map("balance_after")
  createdAt    DateTime      @default(now()) @map("created_at")
  notification Notification?

  @@index([userId, id])
  @@map("bonus_transactions")
}

// Тип уведомления - как вкладки колокольчика на сайте (рефералы и акции сервер пока не шлет)
enum NotificationType {
  order
  bonus

  @@map("notification_type")
}

// Уведомления колокольчика. Строки создают триггеры (миграция 20261027150000_notifications) в той же транзакции,
// что и источник: на каждую смену статуса заказа - по строке истории статусов, на каждое движение бонусов - по строке
// истории бонусов; уникальный источник - ровно одно уведомление. Текст собирает API (server/src/notifications/texts.ts)
model Notification {
  id        BigInt              @id @default(autoincrement())
  userId    String              @map("user_id")
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  orderId   String?             @map("order_id")
  order     Order?              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  historyId BigInt?             @unique @map("history_id")
  history   OrderStatusHistory? @relation(fields: [historyId], references: [id], onDelete: Cascade)
  bonusTxId BigInt?             @unique @map("bonus_tx_id")
  bonusTx   BonusTransaction?   @relation(fields: [bonusTxId], references: [id], onDelete: Cascade)
  readAt    DateTime?           @map("read_at")
  createdAt DateTime            @default(now()) @map("created_at")

  @@index([userId, id])
  @@map("notifications")
}
