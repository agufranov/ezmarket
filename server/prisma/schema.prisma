// Схема базы EzMarket. Гарантии держит сама база: уникальные ключи, CHECK, транзакции.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  // email храним в нижнем регистре - уникальность без учета регистра
  email        String    @unique
  name         String?
  // промокод или код друга, с которым пришел при регистрации
  promo        String?
  // 1 бонус = 1 ₽; не ниже нуля - CHECK в миграции
  bonusBalance Int       @default(0) @map("bonus_balance")
  createdAt    DateTime  @default(now()) @map("created_at")
  sessions     Session[]
  orders       Order[]

  @@map("users")
}

// Статусы заказа пополнения Steam. Допустимые переходы проверяет триггер в миграции 20261026090000_orders
enum OrderStatus {
  created
  pending
  paid
  processing
  completed
  failed
  canceled
  expired

  @@map("order_status")
}

// Заказ пополнения Steam. Текущий статус - здесь, каждая его смена пишется триггером в order_status_history
model Order {
  id             String               @id @default(uuid())
  userId         String               @map("user_id")
  user           User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  // ключ повтора от клиента: повторный POST с тем же ключом вернет тот же заказ
  idempotencyKey String               @map("idempotency_key")
  steamLogin     String               @map("steam_login")
  // суммы - целым числом в минимальных единицах валюты (копейки, центы, тиыны)
  amount         Int
  currency       String
  // сколько платить деньгами (пока равно amount; скидка и бонусы уменьшат)
  payAmount      Int                  @map("pay_amount")
  status         OrderStatus          @default(created)
  // неоплаченный заказ истекает через 30 минут после создания
  expiresAt      DateTime             @map("expires_at")
  // id платежа у платежной системы
  paymentId      String?              @unique @map("payment_id")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  history        OrderStatusHistory[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@map("orders")
}

// История статусов: строки добавляет только триггер, приложение их не пишет
model OrderStatusHistory {
  id         BigInt       @id @default(autoincrement())
  orderId    String       @map("order_id")
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  reason     String?
  createdAt  DateTime     @default(now()) @map("created_at")

  @@index([orderId, id])
  @@map("order_status_history")
}

// Коды входа: сам код нигде не хранится, только HMAC-SHA256 с серверным секретом
model AuthCode {
  id        String    @id @default(uuid())
  email     String
  codeHash  String    @map("code_hash")
  mode      String
  promo     String?
  attempts  Int       @default(0)
  expiresAt DateTime  @map("expires_at")
  // погашен: вход выполнен, исчерпаны попытки или выдан новый код
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@map("auth_codes")
}

// Сессии: в cookie случайный токен, в базе только его SHA-256
model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("sessions")
}

model PromoCode {
  code   String  @id
  active Boolean @default(true)

  @@map("promo_codes")
}

// Исходящие письма: создаются в одной транзакции с действием, отправляет воркер с повторами
model EmailOutbox {
  id        String    @id @default(uuid())
  to        String
  subject   String
  text      String
  html      String?
  attempts  Int       @default(0)
  nextTryAt DateTime  @default(now()) @map("next_try_at")
  sentAt    DateTime? @map("sent_at")
  error     String?
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([sentAt, nextTryAt])
  @@map("email_outbox")
}
