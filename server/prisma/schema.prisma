// Схема базы EzMarket. Гарантии держит сама база: уникальные ключи, CHECK, транзакции.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  // email храним в нижнем регистре - уникальность без учета регистра
  email        String    @unique
  name         String?
  // промокод или код друга, с которым пришел при регистрации
  promo        String?
  // 1 бонус = 1 ₽; не ниже нуля - CHECK в миграции
  bonusBalance Int       @default(0) @map("bonus_balance")
  createdAt    DateTime  @default(now()) @map("created_at")
  sessions     Session[]

  @@map("users")
}

// Коды входа: сам код нигде не хранится, только HMAC-SHA256 с серверным секретом
model AuthCode {
  id        String    @id @default(uuid())
  email     String
  codeHash  String    @map("code_hash")
  mode      String
  promo     String?
  attempts  Int       @default(0)
  expiresAt DateTime  @map("expires_at")
  // погашен: вход выполнен, исчерпаны попытки или выдан новый код
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@map("auth_codes")
}

// Сессии: в cookie случайный токен, в базе только его SHA-256
model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("sessions")
}

model PromoCode {
  code   String  @id
  active Boolean @default(true)

  @@map("promo_codes")
}

// Исходящие письма: создаются в одной транзакции с действием, отправляет воркер с повторами
model EmailOutbox {
  id        String    @id @default(uuid())
  to        String
  subject   String
  text      String
  html      String?
  attempts  Int       @default(0)
  nextTryAt DateTime  @default(now()) @map("next_try_at")
  sentAt    DateTime? @map("sent_at")
  error     String?
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([sentAt, nextTryAt])
  @@map("email_outbox")
}
